<IfModule mod_rewrite.c>
  RewriteEngine On

  # Single-page app fallback. Existing files (images, api/*.php) are served as-is.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
